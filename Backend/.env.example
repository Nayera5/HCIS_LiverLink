# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (frontend dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Neon PostgreSQL connection string (from the Neon dashboard -> Connect)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# Redis (Celery broker/result backend). Celery is switched off for now, so this is unused.
# REDIS_URL=redis://localhost:6379/0

# Paymob online payment (test mode), from the Paymob dashboard with test mode on.
# Leave empty to switch online payment off.
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Card payment integration id(s), comma-separated
PAYMOB_INTEGRATION_IDS=
# Optional: public URL of this backend (e.g. https://xxxx.ngrok-free.app) so Paymob can POST callbacks
PAYMOB_CALLBACK_BASE_URL=

# HL7 listener that receives lab results (python manage.py hl7_listener)
HL7_LISTEN_HOST=127.0.0.1
HL7_LISTEN_PORT=2575

# Email (password reset and email notifications). Leave EMAIL_HOST_USER empty to print emails
# in the runserver terminal instead. Gmail: turn on 2-step verification, then create an
# "app password" and use it as EMAIL_HOST_PASSWORD.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Gmail sends only from the signed-in address
DEFAULT_FROM_EMAIL=LiverLink <you@gmail.com>
